{
  "name": "univapay-node",
  "version": "4.0.168",
  "description": "UnivaPay SDK library for Node.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:univapay/univapay-node.git"
  },
  "bugs": "https://github.com/univapay/univapay-node/issues",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "type": "module",
  "main": "dist/cjs",
  "module": "dist/esm",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./*": {
      "types": "./dist/esm/*.d.ts",
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "jsnext:main": "dist/esm",
  "keywords": [
    "sdk",
    "univapay",
    "util",
    "module"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/chai-arrays": "^2.0.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/sinon": "^22.0.2",
    "@types/sinon-chai": "^4.0.1",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "chai-arrays": "^2.2.0",
    "chai-as-promised": "^8.0.2",
    "cross-fetch": "^4.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fetch-mock": "^12.6.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "isomorphic-form-data": "^2.0.0",
    "jsonwebtoken": "^9.0.3",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.3",
    "np": "^12.1.1",
    "p-map": "^7.1.1",
    "path-to-regexp": "^9.0.0",
    "prettier": "^3.9.10",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-internal-external": "^2.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "typescript7": "npm:typescript@^7.0.2",
    "uuid": "^14.0.3"
  },
  "dependencies": {
    "@apimatic/json-bigint": "^1.2.0",
    "arrify": "^3.0.0",
    "bowser": "^2.15.0",
    "browser-or-node": "^3.0.0",
    "change-case": "^5.4.4",
    "events": "^3.3.0",
    "flat": "^6.0.1",
    "is-buffer": "^2.0.5",
    "jwt-decode": "^4.0.0",
    "p-timeout": "^8.0.0",
    "query-string": "^10.0.0",
    "tslib": "^2.8.1"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "format": "prettier \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" --write",
    "test": "c8 mocha",
    "build:esm": "tsc",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build": "npm run build:esm && npm run build:cjs",
    "preversion": "npm test",
    "docs": "typedoc --options typedoc.json",
    "release": "np --yolo --no-yarn --no-publish",
    "prepare": "husky"
  },
  "overrides": {
    "tmp": "^0.2.7"
  }
}
