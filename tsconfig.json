{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "sourceMap": true,
    "target": "es2020",
    "module": "nodenext",
    "declaration": true,
    "allowJs": false,
    "checkJs": false,
    "lib": [
      "dom",
      "scripthost",
      "es2015",
      "es2016",
      "es2017",
      "esnext",
      "esnext.asynciterable"
    ],
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "noImplicitAny": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noImplicitThis": false,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "./dist/esm",
    "rootDir": "./src",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
